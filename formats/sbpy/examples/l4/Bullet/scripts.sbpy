event_whenflagclicked():
    motion_gotoxy(X=300, Y=300)
    looks_hide()

event_whenbroadcastreceived(BROADCAST_OPTION="fire"):
    motion_gotoxy(X=var("ship x"), Y=-100)
    control_create_clone_of(CLONE_OPTION="_myself_")

control_start_as_clone():
    looks_show()
    control_repeat_until(CONDITION=operator_or(OPERAND1=sensing_touchingobject(TOUCHINGOBJECTMENU="_edge_"), OPERAND2=sensing_touchingobject(TOUCHINGOBJECTMENU="Enemy"))):
        motion_changeyby(DY=12)
    control_delete_this_clone()
