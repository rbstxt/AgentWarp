@a1
define "Rw %s %s %s %s %s" (x, y, dir, z, c) [warp]:
    data_setvariableto(VARIABLE="Rw C", VALUE=arg("c"))
    data_setvariableto(VARIABLE="Rw siz", VALUE=arg("z"))
    data_setvariableto(VARIABLE="clone Dir", VALUE=arg("dir"))
    data_setvariableto(VARIABLE="clone X", VALUE=arg("x"))
    data_setvariableto(VARIABLE="clone Y", VALUE=arg("y"))
    data_setvariableto(VARIABLE="Cam Control?", VALUE="1")
    data_setvariableto(VARIABLE="ID", VALUE="rw")
    control_create_clone_of(CLONE_OPTION="_myself_")
    data_setvariableto(VARIABLE="clone X", VALUE=operator_add(NUM1=arg("x"), NUM2="25"))
    data_setvariableto(VARIABLE="clone Y", VALUE=operator_subtract(NUM1=arg("y"), NUM2="15"))
    data_setvariableto(VARIABLE="ID", VALUE="rw影")
    control_create_clone_of(CLONE_OPTION="_myself_")

