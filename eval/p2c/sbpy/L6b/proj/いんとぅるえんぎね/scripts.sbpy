@a24
define "しゃけ %s %s %s %s" (たいむ, °, x, y) defaults=["", "", "", "", "", ""]:
    data_setvariableto(VARIABLE="しゃけ", VALUE="60")
    control_repeat(TIMES=arg("たいむ")):
        data_changevariableby(VARIABLE="しゃけ", VALUE=operator_divide(NUM1=operator_subtract(NUM1="0", NUM2=var("しゃけ")), NUM2="5"))
        motion_gotoxy(X=operator_add(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_mathop(OPERATOR="sin", NUM=operator_multiply(NUM1=sensing_timer(), NUM2="600")), NUM2="0.9"), NUM2=var("しゃけ")), NUM2=arg("x")), Y=operator_add(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_mathop(OPERATOR="cos", NUM=operator_multiply(NUM1=sensing_timer(), NUM2="600")), NUM2="0.9"), NUM2=var("しゃけ")), NUM2=arg("y")))
        motion_pointindirection(DIRECTION=operator_add(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_mathop(OPERATOR="sin", NUM=operator_multiply(NUM1=sensing_timer(), NUM2="800")), NUM2="1.5"), NUM2=operator_divide(NUM1=var("しゃけ"), NUM2="7")), NUM2=arg("°")))
        data_setvariableto(VARIABLE="ShakeDir", VALUE=operator_add(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_mathop(OPERATOR="sin", NUM=operator_multiply(NUM1=sensing_timer(), NUM2="800")), NUM2="1.5"), NUM2=operator_divide(NUM1=var("しゃけ"), NUM2="7")), NUM2=operator_subtract(NUM1=arg("°"), NUM2="90")))
        data_setvariableto(VARIABLE="ShakeX", VALUE=operator_add(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_mathop(OPERATOR="sin", NUM=operator_multiply(NUM1=sensing_timer(), NUM2="600")), NUM2="0.9"), NUM2=var("しゃけ")), NUM2=arg("x")))
        data_setvariableto(VARIABLE="ShakeY", VALUE=operator_add(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_mathop(OPERATOR="cos", NUM=operator_multiply(NUM1=sensing_timer(), NUM2="600")), NUM2="0.9"), NUM2=var("しゃけ")), NUM2=arg("y")))

