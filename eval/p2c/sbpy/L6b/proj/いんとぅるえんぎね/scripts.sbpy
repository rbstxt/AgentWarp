@a15
control_start_as_clone():
    control_if(CONDITION=operator_equals(OPERAND1=var("ID"), OPERAND2="fw")):
        looks_seteffectto(EFFECT="GHOST", VALUE="0")
        looks_gotofrontback(FRONT_BACK="front")
        control_if_else(CONDITION=operator_equals(OPERAND1=var("Fw type"), OPERAND2="a")):
            looks_seteffectto(EFFECT="COLOR", VALUE=var("Fw Color"))
            looks_switchcostumeto(COSTUME="le1")
            control_repeat(TIMES="10"):
                looks_nextcostume()
            control_repeat(TIMES="2"):
                looks_nextcostume()
                looks_changeeffectby(EFFECT="GHOST", CHANGE="10")
            control_delete_this_clone()
        else:
            control_if_else(CONDITION=operator_equals(OPERAND1=var("Fw type"), OPERAND2="b")):
                control_if_else(CONDITION=data_listcontainsitem(LIST="Fwのためだけのリスト。", ITEM=var("Fw"))):
                    looks_seteffectto(EFFECT="BRIGHTNESS", VALUE="100")
                    looks_seteffectto(EFFECT="COLOR", VALUE=var("Fw Color"))
                    looks_switchcostumeto(COSTUME="le1")
                    control_repeat(TIMES="10"):
                        looks_nextcostume()
                    control_repeat(TIMES="2"):
                        looks_nextcostume()
                        looks_changeeffectby(EFFECT="GHOST", CHANGE="10")
                    control_delete_this_clone()
                else:
                    looks_seteffectto(EFFECT="BRIGHTNESS", VALUE="0")
                    looks_seteffectto(EFFECT="COLOR", VALUE=var("Fw Color"))
                    looks_switchcostumeto(COSTUME="le1")
                    control_repeat(TIMES="10"):
                        looks_nextcostume()
                    control_repeat(TIMES="2"):
                        looks_nextcostume()
                        looks_changeeffectby(EFFECT="GHOST", CHANGE="10")
                    control_delete_this_clone()
            else:
                pass

