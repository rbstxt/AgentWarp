        data_setvariableto(VARIABLE="clone Z", VALUE="0")
        looks_switchcostumeto(COSTUME="text")
        control_repeat_until(CONDITION=operator_equals(OPERAND1=operator_round(NUM=var("clone Z")), OPERAND2="100")):
            data_changevariableby(VARIABLE="clone Z", VALUE=operator_divide(NUM1=operator_subtract(NUM1="100", NUM2=var("clone Z")), NUM2="3"))
