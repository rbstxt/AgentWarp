    motion_gotoxy(X=operator_subtract(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_add(NUM1=var("clone X"), NUM2=operator_add(NUM1=var("🎥 X"), NUM2=var("ShakeX"))), NUM2=var("🎥 Z")), NUM2=operator_mathop(OPERATOR="cos", NUM=operator_add(NUM1=var("🎥 Dir"), NUM2=var("ShakeDir")))), NUM2=operator_multiply(NUM1=operator_multiply(NUM1=operator_add(NUM1=var("clone Y"), NUM2=operator_add(NUM1=var("🎥 Y"), NUM2=var("ShakeY"))), NUM2=var("🎥 Z")), NUM2=operator_mathop(OPERATOR="sin", NUM=operator_add(NUM1=var("🎥 Dir"), NUM2=var("ShakeDir"))))), Y=operator_add(NUM1=operator_multiply(NUM1=operator_multiply(NUM1=operator_add(NUM1=var("clone X"), NUM2=operator_add(NUM1=var("🎥 X"), NUM2=var("ShakeX"))), NUM2=var("🎥 Z")), NUM2=operator_mathop(OPERATOR="sin", NUM=operator_add(NUM1=var("🎥 Dir"), NUM2=var("ShakeDir")))), NUM2=operator_multiply(NUM1=operator_multiply(NUM1=operator_add(NUM1=var("clone Y"), NUM2=operator_add(NUM1=var("🎥 Y"), NUM2=var("ShakeY"))), NUM2=var("🎥 Z")), NUM2=operator_mathop(OPERATOR="cos", NUM=operator_add(NUM1=var("🎥 Dir"), NUM2=var("ShakeDir"))))))  # This is the block that positions the clones. It uses some trigonometry, and I dont fully understand how it works, but you can view some of @MathMathMath's tutorials for more info
