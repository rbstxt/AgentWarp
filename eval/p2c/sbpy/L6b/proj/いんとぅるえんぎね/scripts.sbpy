@a6
control_start_as_clone():
    control_if(CONDITION=operator_equals(OPERAND1=var("ID"), OPERAND2="rw")):
        looks_seteffectto(EFFECT="COLOR", VALUE=var("Rw C"))
        looks_gotofrontback(FRONT_BACK="front")
        looks_seteffectto(EFFECT="GHOST", VALUE="0")
        looks_show()
        looks_switchcostumeto(COSTUME="Filler (Size)")
        data_setvariableto(VARIABLE="clone Z", VALUE="0")
        looks_switchcostumeto(COSTUME="Diamond 1")
        control_repeat(TIMES="15"):
            data_changevariableby(VARIABLE="clone Z", VALUE=operator_divide(NUM1=operator_subtract(NUM1=var("Rw siz"), NUM2=looks_size()), NUM2="7"))
            looks_nextcostume()
        control_repeat(TIMES="7"):
            data_changevariableby(VARIABLE="clone Z", VALUE=operator_divide(NUM1=operator_subtract(NUM1=var("Rw siz"), NUM2=looks_size()), NUM2="4"))
            looks_nextcostume()
            looks_changeeffectby(EFFECT="GHOST", CHANGE="1")
        looks_hide()

@a7
define "Fw %s %s %s %s %s type %s" (x, y, z, 本数, Color, "") [warp] defaults=["", "", "", "", "", "", ""]:
    data_setvariableto(VARIABLE="clone Dir", VALUE="0")
    data_setvariableto(VARIABLE="Fw Color", VALUE=arg("Color"))
    data_setvariableto(VARIABLE="Fw type", VALUE=arg(""))
    data_setvariableto(VARIABLE="clone X", VALUE=arg("x"))
    data_setvariableto(VARIABLE="clone Y", VALUE=arg("y"))
    data_setvariableto(VARIABLE="clone Z", VALUE=arg("z"))
    data_setvariableto(VARIABLE="Fw", VALUE="0")
    control_repeat(TIMES=arg("本数")):
        data_changevariableby(VARIABLE="Fw", VALUE="1")
        data_changevariableby(VARIABLE="clone Dir", VALUE=operator_divide(NUM1="360", NUM2=arg("本数")))
        call("Clone %s %s", ID="fw", CC?="1")
    data_setvariableto(VARIABLE="clone X", VALUE=operator_add(NUM1=arg("x"), NUM2="25"))
    data_setvariableto(VARIABLE="clone Y", VALUE=operator_subtract(NUM1=arg("y"), NUM2="15"))
    control_repeat(TIMES=arg("本数")):
        data_changevariableby(VARIABLE="Fw", VALUE="1")
        data_changevariableby(VARIABLE="clone Dir", VALUE=operator_divide(NUM1="360", NUM2=arg("本数")))
        call("Clone %s %s", ID="fw影", CC?="1")

@a8
control_start_as_clone():
    control_if(CONDITION=operator_equals(OPERAND1=var("ID"), OPERAND2="sw")):
        looks_gotofrontback(FRONT_BACK="front")
        control_if(CONDITION=operator_equals(OPERAND1=var("Sw,type"), OPERAND2="a")):
            looks_seteffectto(EFFECT="COLOR", VALUE=var("Sw C"))
            data_setvariableto(VARIABLE="sw", VALUE="10")
            data_setvariableto(VARIABLE="clone Z", VALUE="0")
            looks_switchcostumeto(COSTUME="sw")
            looks_seteffectto(EFFECT="FISHEYE", VALUE="0")
            control_repeat(TIMES="70"):
                data_setvariableto(VARIABLE="sw", VALUE=operator_multiply(NUM1=var("sw"), NUM2="1.19"))
                looks_changeeffectby(EFFECT="FISHEYE", CHANGE=var("sw"))
                data_changevariableby(VARIABLE="clone Z", VALUE=operator_divide(NUM1=operator_subtract(NUM1=var("sw z"), NUM2=looks_size()), NUM2="5"))
        control_if(CONDITION=operator_equals(OPERAND1=var("Sw,type"), OPERAND2="b")):
            looks_seteffectto(EFFECT="COLOR", VALUE=var("Sw C"))
            data_setvariableto(VARIABLE="sw", VALUE="10")
            data_setvariableto(VARIABLE="clone Z", VALUE="0")
            looks_seteffectto(EFFECT="FISHEYE", VALUE="0")
            looks_switchcostumeto(COSTUME="1/2sw")
            data_setvariableto(VARIABLE="clone Dir", VALUE=var("Sw dir"))
            control_repeat(TIMES="70"):
                data_setvariableto(VARIABLE="sw", VALUE=operator_multiply(NUM1=var("sw"), NUM2="1.19"))
                looks_changeeffectby(EFFECT="FISHEYE", CHANGE=var("sw"))
                data_changevariableby(VARIABLE="clone Z", VALUE=operator_divide(NUM1=operator_subtract(NUM1=var("sw z"), NUM2=looks_size()), NUM2="5"))
        control_delete_this_clone()

