@a7
define Fw (x) (y) (z) (本数) (Color) type ("") :: {"argumentdefaults":["","","","","","",""]} :: warp
set [clone Dir v] to ["0"]
set [Fw Color v] to (Color)
set [Fw type v] to (:: args)
set [clone X v] to (x)
set [clone Y v] to (y)
set [clone Z v] to (z)
set [Fw v] to ["0"]
repeat (本数)
  change [Fw v] by ("1")
  change [clone Dir v] by (("360") / (本数))
  Clone [fw] ["1"]
end
set [clone X v] to ((x) + ("25"))
set [clone Y v] to ((y) - ("15"))
repeat (本数)
  change [Fw v] by ("1")
  change [clone Dir v] by (("360") / (本数))
  Clone [fw影] ["1"]
end

@a8
when I start as a clone
if <(ID) = [sw]> then
  go to [front v] layer
  if <(Sw,type) = [a]> then
    set [color v] effect to (Sw C)
    set [sw v] to ["10"]
    set [clone Z v] to ["0"]
    switch costume to [sw v]
    set [fisheye v] effect to ("0")
    repeat ("70")
      set [sw v] to ((sw) * ("1.19"))
      change [fisheye v] effect by (sw)
      change [clone Z v] by (((sw z) - (size)) / ("5"))
    end
  end
  if <(Sw,type) = [b]> then
    set [color v] effect to (Sw C)
    set [sw v] to ["10"]
    set [clone Z v] to ["0"]
    set [fisheye v] effect to ("0")
    switch costume to [1/2sw v]
    set [clone Dir v] to (Sw dir)
    repeat ("70")
      set [sw v] to ((sw) * ("1.19"))
      change [fisheye v] effect by (sw)
      change [clone Z v] by (((sw z) - (size)) / ("5"))
    end
  end
  delete this clone
end

