@a3
define Sw Type ("") x,y,dir (x) (y) (d) size (z) Color (c) :: {"argumentdefaults":["","","","","","","",""]} :: warp
set [Sw C v] to (c)
set [Sw,type v] to (:: args)
set [clone X v] to (x)
set [clone Y v] to (y)
set [sw z v] to (z)
set [Sw dir v] to (d)
set [Cam Control? v] to ["1"]
set [ID v] to [sw]
create clone of [myself v]
set [clone X v] to ((x) + ("25"))
set [clone Y v] to ((y) - ("15"))
set [ID v] to [sw影]
create clone of [myself v]

@a4
when I start as a clone
if <(ID) = [rw影]> then
  go to [front v] layer
  go [backward v] ("1") layers
  set [brightness v] effect to ("-100")
  set [ghost v] effect to ("50")
  show
  switch costume to [Filler \(Size\) v]
  set [clone Z v] to ["0"]
  switch costume to [Diamond 1 v]
  repeat ("15")
    change [clone Z v] by (((Rw siz) - (size)) / ("7"))
    next costume
  end
  repeat ("7")
    change [clone Z v] by (((Rw siz) - (size)) / ("4"))
    next costume
    change [ghost v] effect by ("1")
  end
  hide
end

