@a15
when I start as a clone
if <(ID) = [fw]> then
  set [ghost v] effect to ("0")
  go to [front v] layer
  if <(Fw type) = [a]> then
    set [color v] effect to (Fw Color)
    switch costume to [le1 v]
    repeat ("10")
      next costume
    end
    repeat ("2")
      next costume
      change [ghost v] effect by ("10")
    end
    delete this clone
  else
    if <(Fw type) = [b]> then
      if <[Fwのためだけのリスト。 v] contains (Fw) ?> then
        set [brightness v] effect to ("100")
        set [color v] effect to (Fw Color)
        switch costume to [le1 v]
        repeat ("10")
          next costume
        end
        repeat ("2")
          next costume
          change [ghost v] effect by ("10")
        end
        delete this clone
      else
        set [brightness v] effect to ("0")
        set [color v] effect to (Fw Color)
        switch costume to [le1 v]
        repeat ("10")
          next costume
        end
        repeat ("2")
          next costume
          change [ghost v] effect by ("10")
        end
        delete this clone
      end
    else
    end
  end
end

