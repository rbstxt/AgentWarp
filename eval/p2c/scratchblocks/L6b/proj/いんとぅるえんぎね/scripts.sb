@a24
define しゃけ (たいむ) (°) (x) (y) :: {"argumentdefaults":["","","","","",""]}
set [しゃけ v] to ["60"]
repeat (たいむ)
  change [しゃけ v] by ((("0") - (しゃけ)) / ("5"))
  go to x: (((([sin v] of ((timer) * ("600"))) * ("0.9")) * (しゃけ)) + (x)) y: (((([cos v] of ((timer) * ("600"))) * ("0.9")) * (しゃけ)) + (y))
  point in direction (((([sin v] of ((timer) * ("800"))) * ("1.5")) * ((しゃけ) / ("7"))) + (°))
  set [ShakeDir v] to (((([sin v] of ((timer) * ("800"))) * ("1.5")) * ((しゃけ) / ("7"))) + ((°) - ("90")))
  set [ShakeX v] to (((([sin v] of ((timer) * ("600"))) * ("0.9")) * (しゃけ)) + (x))
  set [ShakeY v] to (((([cos v] of ((timer) * ("600"))) * ("0.9")) * (しゃけ)) + (y))
end

