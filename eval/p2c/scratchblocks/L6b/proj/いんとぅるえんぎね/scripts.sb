@a1
define Rw (x) (y) (dir) (z) (c) :: warp
set [Rw C v] to (c)
set [Rw siz v] to (z)
set [clone Dir v] to (dir)
set [clone X v] to (x)
set [clone Y v] to (y)
set [Cam Control? v] to ["1"]
set [ID v] to [rw]
create clone of [myself v]
set [clone X v] to ((x) + ("25"))
set [clone Y v] to ((y) - ("15"))
set [ID v] to [rw影]
create clone of [myself v]

