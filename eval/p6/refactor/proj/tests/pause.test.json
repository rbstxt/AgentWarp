[
  {
    "name": "P pauses the game",
    "frames": 200,
    "input": [
      { "frame": 5, "type": "broadcast", "name": "enter game" },
      { "frame": 60, "type": "keydown", "key": "p" },
      { "frame": 90, "type": "keyup", "key": "p" }
    ],
    "expect": [
      { "probe": "Stage.variables.Paused", "op": "==", "value": 1 },
      { "probe": "PauseMenu.visible", "op": "==", "value": true }
    ]
  },
  {
    "name": "space resumes the game",
    "frames": 260,
    "input": [
      { "frame": 5, "type": "broadcast", "name": "enter game" },
      { "frame": 60, "type": "keydown", "key": "p" },
      { "frame": 90, "type": "keyup", "key": "p" },
      { "frame": 140, "type": "keydown", "key": "space" },
      { "frame": 170, "type": "keyup", "key": "space" }
    ],
    "expect": [
      { "probe": "Stage.variables.Paused", "op": "==", "value": 0 },
      { "probe": "PauseMenu.visible", "op": "==", "value": false }
    ]
  }
]
